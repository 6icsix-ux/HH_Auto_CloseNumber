{
  "manifest_version": 3,
  "name": "KeyHuay - คัดลอกภาพโพย (ทดสอบ)",
  "version": "1.2.0",
  "description": "หน้าส่งโพย keyhuay888: คัดลอกภาพรวม 3 ส่วน (ส่วนหัว + ตารางเลขที่ซื้อ + บันทึกช่วยจำ) เป็นภาพเดียว",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://*.digitaloceanspaces.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.keyhuay888.com/*", "https://*.keyhuay888.com/*"],
      "js": ["html-to-image.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
